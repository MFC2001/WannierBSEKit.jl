&INPUT_PW2BGW
  prefix = 'pwscf'
  outdir = './'

  ! Set 1 for real flavor of BerkeleyGW (for systems with inversion symmetry
  ! and time-reversal symmetry) or 2 for complex flavor of BerkeleyGW (for
  ! systems without inversion symmetry and time-reversal symmetry)
  real_or_complex = 2

  wfng_flag = .true.
  wfng_file = 'WFN'
  wfng_kgrid = .true.

  !kgrid
  wfng_nk1 = 15
  wfng_nk2 = 15
  wfng_nk3 = 15
  wfng_dk1 = 0.0
  wfng_dk2 = 0.0
  wfng_dk3 = 0.015

  ! wfng_occupation = .true.
  ! wfng_nvmin = 1
  ! wfng_nvmax = 5

  !RHO
  ! rhog_flag = .true.
  ! rhog_file = 'RHO'
  !VXC
  ! vxcg_flag = .true.
  ! vxcg_file = 'VXC'
  ! vxc_flag = .true.
  ! vxc_file = 'vxc.dat'
  ! vxc_diag_nmin = 1
  ! vxc_diag_nmax = 36
  ! vxc_offdiag_nmin = 0
  ! vxc_offdiag_nmax = 0
/


