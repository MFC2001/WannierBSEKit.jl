&CONTROL
  title         = 'MoS2',
!  restart_mode  = 'restart', !default:'from_scratch'
  calculation   = 'bands',      !options:'scf','nscf','bands','relax','vc-relax',etc.
  tprnfor       = .true., 
  tstress       = .true.,
  forc_conv_thr = 1.0d-3,
  disk_io       = 'low'
  verbosity     = 'high',
  pseudo_dir    = 'path/to/dojo-pseudopotential/nc-fr-04_pbe_standard/', 
  outdir        = './', 
/

&SYSTEM
  ibrav = 4,   
  A = 3.186,
  C = 30,
  nat   = 3,  !number of atoms in the unit cell
  ntyp  = 2,   !number of types of atoms in the unit cell
  nbnd  = 300, !Set it manually.
  occupations = 'fixed', !also can use 'fixed' for insulators.
  ecutwfc   = 100,  !Ry
!  ecutrho   = 720,  !default:4*ecutwfc, and use a bigger one for USPP.
!  input_dft = 'hse'
  assume_isolated = '2D'
!  exxdiv_treatment = 'vcut_spherical' !treat the Coulomb potential divergencies at small q vectors.
!  x_gamma_extrapolation = .false. !incompatible with vcut.
!  ecutfock = 300 !default:ecutrho, must be .gt. ecutwfc.
!  nr1=243, nr2=243, nr3=162
!  nspin = 2
  noncolin = .true.
  lspinorb = .true.
/

&ELECTRONS
  electron_maxstep = 200 !default:100
  conv_thr = 1.d-8,
  adaptive_thr = .true. !useful when using EXX.
!  exx_maxstep = 200 !default:100
!  mixing_mode = 'local-TF' !default:plain
!  mixing_beta = 0.6
  diago_full_acc = .true., !For calculating unoccupied states at the same level of accuracy.
!  diagonalization = 'cg'
!  diago_cg_maxiter = 150
  diago_david_ndim = 4
!  startingpot = 'file',
!  startingwfc = 'file',
/

&IONS
  ion_dynamics = 'bfgs'
/

&CELL
  cell_dofree    = '2Dxy',
  press_conv_thr = 0.1
/


ATOMIC_SPECIES
  Mo  95.95  Mo.upf
  S   32.06   S.upf 

ATOMIC_POSITIONS (crystal)
Mo            0.3333333333        0.6666666667        0.5000000000
S             0.6666666667        0.3333333333        0.5521224027
S             0.6666666667        0.3333333333        0.4478775973

