# Command checklist for the graphone workflow.
# Run each program block inside the directory named by its comment (# 01-scf,
# # 02-p2y, ...); run the cp/ln preparation lines from this examples/graphone
# directory.  Modify pseudo_dir, the $...bin variables and the paths for your
# own installation.

# 01-scf
mpirun -np 24 $QEbin/pw.x < pw.in > pw.out
##
cp ./01-scf/pwscf.save ./02-p2y/pwscf.save -r
cp ./01-scf/pwscf.save ./04-nscf/pwscf.save -r

# 02-p2y
mpirun -np 24 $QEbin/pw.x < pw.in > pw.out
mpirun -np 24 $yambobin/p2y -I pwscf.save -O ./
##
ln -sf ./02-p2y/SAVE ./03-epsilon/SAVE

# 03-epsilon
$yambobin/yambo -F init.in
mpirun -np 24 $yambobin/yambo -J epsilon -F epsilon.in

# 04-nscf
mpirun -np 24 $QEbin/pw.x < pw.in > pw.out
##
ln -sf ./04-nscf/pwscf.save ./05-wannier/up/pwscf.save
ln -sf ./04-nscf/pwscf.save ./05-wannier/dn/pwscf.save

# 05-wannier/up
$QEbin/wannier90.x -pp wannier90
mpirun -np 24 $QEbin/pw2wannier90.x <pw2wannier90.in >pw2wannier90.out
$QEbin/wannier90.x wannier90

# 05-wannier/dn
$QEbin/wannier90.x -pp wannier90
mpirun -np 24 $QEbin/pw2wannier90.x <pw2wannier90.in >pw2wannier90.out
$QEbin/wannier90.x wannier90

# 06-interaction
$juliabin/julia -t 24 wannierinteraction.jl > runlog

# 07-bse
$juliabin/julia -t 24 bseband.jl > runlog
